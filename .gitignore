# Never commit these. The signature and identity assets are private.
personal identity/
*-PRIVATE/
*.p12
*.pfx

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Dependencies and build output
node_modules/
vendor/
dist/
build/
.wrangler/

# WordPress
wp-config.php
wp-content/uploads/
wp-content/cache/
wp/

# Local
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.sql
*.sql.gz

# Python
__pycache__/
*.pyc

# AI working files. The approved project configuration IS versioned: .specify/ (Spec Kit templates, scripts,
# constitution) and .claude/skills/ (Spec Kit and guard skills). Personal and machine-specific state is not.
.claude/*
!.claude/skills/
.claude/settings.local.json
.agents/
.specify/extensions/.cache/
.specify/**/*.local.*

# Board sync state, local to whoever ran the setup script
scripts/.board-state.json

# CoreX client-site local state (from the make:site scaffold)
.corex/docs/
.corex/cache/
.corex/local-notes/
.ai/
.codex/local/
