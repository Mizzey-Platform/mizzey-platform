{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mizzey/signup",
	"title": "Sign-up prompt",
	"category": "mizzey-sections",
	"icon": "email",
	"description": "A heading, a line and an email sign-up with an optional box for news and offers.",
	"keywords": [
		"sign up",
		"newsletter",
		"email"
	],
	"textdomain": "mizzey-site",
	"attributes": {
		"visible": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"ctaLabel": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"align": false,
		"reusable": false,
		"lock": false
	},
	"example": {},
	"editorScript": "file:./edit.js",
	"editorStyle": "mizzey-section-library-editor",
	"style": "file:./style.css",
	"viewScriptModule": "file:./view.js",
	"render": "file:./render.php"
}
