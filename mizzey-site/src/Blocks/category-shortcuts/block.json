{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mizzey/category-shortcuts",
	"title": "Category shortcuts",
	"category": "mizzey-sections",
	"icon": "grid-view",
	"description": "The categories marked to show on the home page, as image tiles, and a tile for all categories.",
	"keywords": [
		"categories",
		"shortcuts",
		"shop by category"
	],
	"textdomain": "mizzey-site",
	"attributes": {
		"visible": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"allLabel": {
			"type": "string",
			"default": ""
		},
		"allUrl": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"align": false,
		"reusable": false,
		"lock": false
	},
	"example": {},
	"editorScript": "file:./edit.js",
	"editorStyle": "mizzey-section-library-editor",
	"style": [
		"mizzey-home-sections",
		"file:./style.css"
	],
	"render": "file:./render.php"
}
