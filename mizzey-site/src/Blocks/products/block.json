{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mizzey/products",
	"title": "Products",
	"category": "mizzey-sections",
	"icon": "products",
	"description": "A row of product cards from a rule (a badge, a category, a collection, the newest, on sale) or picked by hand.",
	"keywords": [
		"trending",
		"new arrivals",
		"products",
		"rail"
	],
	"textdomain": "mizzey-site",
	"attributes": {
		"visible": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": ""
		},
		"source": {
			"type": "string",
			"enum": [
				"badge",
				"category",
				"collection",
				"newest",
				"sale",
				"products"
			],
			"default": "badge"
		},
		"badge": {
			"type": "string",
			"enum": [
				"trending",
				"new",
				"limited",
				"best-seller"
			],
			"default": "trending"
		},
		"term": {
			"type": "integer",
			"default": 0
		},
		"products": {
			"type": "array",
			"default": [],
			"items": {
				"type": "integer"
			}
		},
		"count": {
			"type": "integer",
			"default": 12
		},
		"link": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"className": false,
		"color": false,
		"typography": false,
		"spacing": false,
		"align": false,
		"reusable": false,
		"lock": false
	},
	"example": {},
	"editorScript": "file:./edit.js",
	"editorStyle": [
		"mizzey-section-library-editor",
		"mizzey-product-card-style",
		"mizzey-product-rail-style"
	],
	"style": [
		"mizzey-product-rail-style",
		"file:./style.css"
	],
	"render": "file:./render.php"
}
