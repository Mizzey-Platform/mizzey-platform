{
  "version": "1.0.0-product-sheet",
  "rules_version": 1,
  "note": "The mapping for Mizzey's product sheet (Mizzey-Product-Sheet.csv), the one initial migration (MIG-04). Any column named option_<name> fills the attribute <name>, so the sheet may carry any option. Bump the version when the sheet's columns change. See specs/051-product-sheet-import.",
  "source": {
    "format": "csv",
    "encoding": "UTF-8"
  },
  "columns": {
    "row_type": {
      "to": "row_type"
    },
    "sku": {
      "to": "sku"
    },
    "parent_sku": {
      "to": "parent_sku"
    },
    "name_en": {
      "to": "name"
    },
    "name_ar": {
      "to": "name_ar"
    },
    "description_en": {
      "to": "description"
    },
    "description_ar": {
      "to": "description_ar"
    },
    "price": {
      "to": "regular_price"
    },
    "sale_price": {
      "to": "sale_price"
    },
    "cost": {
      "to": "cost"
    },
    "category": {
      "to": "category"
    },
    "brand": {
      "to": "brand"
    },
    "image_urls": {
      "to": "images"
    },
    "seo_title": {
      "to": "seo_title"
    },
    "seo_description": {
      "to": "seo_description"
    },
    "amazon_asin": {
      "to": "source_asin"
    }
  },
  "prefixes": {
    "option_": {
      "to": "attribute_",
      "note": "One column per option, named by the client: option_size, option_colour, option_capacity, option_scent"
    }
  },
  "row_type": {
    "values": {
      "simple": "simple",
      "parent": "variable",
      "variation": "variation"
    }
  }
}
