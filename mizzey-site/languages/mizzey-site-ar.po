#: mizzey-site/src/Promotions/PromotionRules.php
msgid "Only one promotion applies per order."
msgstr "يُطبَّق عرض واحد فقط لكل طلب."

#: mizzey-site/src/Promotions/PromotionRules.php
msgid "This coupon cannot be used."
msgstr "لا يمكن استخدام هذه القسيمة."

#: mizzey-site/src/Promotions/PromotionRules.php

msgid "This coupon is paused."
msgstr "هذه القسيمة متوقفة مؤقتًا."

#: mizzey-site/src/Promotions/PromotionRules.php
msgid "This coupon is not active yet."
msgstr "هذه القسيمة غير مفعّلة بعد."

#: mizzey-site/src/Promotions/PromotionRules.php
msgid "This coupon is for a first order only."
msgstr "هذه القسيمة للطلب الأول فقط."

#: mizzey-site/src/Promotions/PromotionRules.php
#, php-format
msgid "This coupon needs at least %d item in your cart."
msgid_plural "This coupon needs at least %d items in your cart."
msgstr[0] "تتطلب هذه القسيمة %d منتج على الأقل في سلتك."
msgstr[1] "تتطلب هذه القسيمة منتجًا واحدًا على الأقل في سلتك."
msgstr[2] "تتطلب هذه القسيمة منتجين على الأقل في سلتك."
msgstr[3] "تتطلب هذه القسيمة %d منتجات على الأقل في سلتك."
msgstr[4] "تتطلب هذه القسيمة %d منتجًا على الأقل في سلتك."
msgstr[5] "تتطلب هذه القسيمة %d منتج على الأقل في سلتك."

#: mizzey-site/src/Accounts/MarketingConsent.php
msgid "Send me offers and news by email. You can stop at any time."
msgstr "أرسلوا لي العروض والأخبار عبر البريد الإلكتروني. يمكنني الإيقاف في أي وقت."

#: mizzey-site/src/Accounts/PhoneSignIn.php
msgid "Mobile number"
msgstr "رقم الجوال"

#: mizzey-site/src/Accounts/PhoneSignIn.php
msgid "(optional)"
msgstr "(اختياري)"

#: mizzey-site/src/Accounts/PhoneSignIn.php
msgid "Please enter a mobile number such as 01012345678."
msgstr "يرجى إدخال رقم جوال مثل 01012345678."

#: mizzey-site/src/Accounts/PhoneSignIn.php
msgid "This mobile number is already used by another account."
msgstr "رقم الجوال هذا مستخدم في حساب آخر."

#: mizzey-site/src/Accounts/SignInLink.php
msgid "If an account exists for that email, a sign-in link is on its way."
msgstr "إذا كان هناك حساب بهذا البريد الإلكتروني، فرابط تسجيل الدخول في طريقه إليك."

#: mizzey-site/src/Accounts/SignInLink.php
msgid "Your sign-in link"
msgstr "رابط تسجيل الدخول"

#: mizzey-site/src/Accounts/SignInLink.php
msgid "This sign-in link has expired or was already used. Ask for a new one."
msgstr "انتهت صلاحية رابط تسجيل الدخول هذا أو استُخدم من قبل. اطلب رابطًا جديدًا."

#: mizzey-site/src/Accounts/SignInLink.php
#. translators: 1: the sign-in link, 2: minutes it stays valid.
#, php-format
msgid "Use this link to sign in to your account:\n\n%1$s\n\nIt works once and expires in %2$d minutes. If you did not ask for it, you can ignore this email."
msgstr "استخدم هذا الرابط لتسجيل الدخول إلى حسابك:\n\n%1$s\n\nيعمل مرة واحدة وتنتهي صلاحيته خلال %2$d دقيقة. إذا لم تطلبه، يمكنك تجاهل هذه الرسالة."

msgid "You are already signed in to another account. Sign out first to use this sign-in link."
msgstr "أنت مسجّل الدخول بالفعل إلى حساب آخر. سجّل الخروج أولاً لاستخدام رابط تسجيل الدخول هذا."

msgid "Sign in with the link from your email?"
msgstr "هل تريد تسجيل الدخول بالرابط الموجود في بريدك الإلكتروني؟"

msgid "Sign in"
msgstr "تسجيل الدخول"

#: mizzey-site/src/Wishlist/Wishlist.php
msgid "This item is not in your wishlist."
msgstr "هذا المنتج غير موجود في قائمة أمنياتك."

#: mizzey-site/src/Wishlist/Wishlist.php
msgid "This item is out of stock, so it stays in your wishlist."
msgstr "هذا المنتج غير متوفر حاليًا، لذلك يبقى في قائمة أمنياتك."

#: mizzey-site/src/Wishlist/Wishlist.php
msgid "This item could not be added to your cart, so it stays in your wishlist."
msgstr "تعذّرت إضافة هذا المنتج إلى سلتك، لذلك يبقى في قائمة أمنياتك."

#: mizzey-site/src/Wishlist/WishlistRoutes.php
msgid "This product could not be found."
msgstr "تعذّر العثور على هذا المنتج."

#: mizzey-site/src/Cart/CartStock.php
#. translators: %s: product name.
#, php-format
msgid "We could not confirm that %s is in stock. Please try again in a few minutes."
msgstr "لم نتمكن من التأكد من توفر %s في المخزون. يرجى المحاولة مرة أخرى بعد بضع دقائق."

#: mizzey-site/src/Cart/CartStock.php
#. translators: 1: units available, 2: product name.
#, php-format
msgid "Only %1$d of %2$s is available. Please change the quantity in your cart."
msgid_plural "Only %1$d of %2$s are available. Please change the quantity in your cart."
msgstr[0] "لا تتوفر أي قطعة من %2$s. يرجى تعديل الكمية في سلتك."
msgstr[1] "تتوفر قطعة واحدة فقط من %2$s. يرجى تعديل الكمية في سلتك."
msgstr[2] "تتوفر قطعتان فقط من %2$s. يرجى تعديل الكمية في سلتك."
msgstr[3] "تتوفر %1$d قطع فقط من %2$s. يرجى تعديل الكمية في سلتك."
msgstr[4] "تتوفر %1$d قطعة فقط من %2$s. يرجى تعديل الكمية في سلتك."
msgstr[5] "تتوفر %1$d قطعة فقط من %2$s. يرجى تعديل الكمية في سلتك."

#: mizzey-site/src/Cart/CartStock.php
#. translators: %s: product name.
#, php-format
msgid "%s is out of stock. Please remove it from your cart."
msgstr "%s غير متوفر في المخزون. يرجى إزالته من سلتك."

#: mizzey-site/src/Cart/CartMerge.php
#. translators: %s: product names.
#, php-format
msgid "We lowered the quantity of %s to what is available."
msgstr "خفّضنا كمية %s إلى المتوفر."

#: mizzey-site/src/Wishlist/Wishlist.php
msgid "This item is not in your cart."
msgstr "هذا المنتج ليس في سلتك."

#: mizzey-site/src/Wishlist/WishlistRoutes.php
msgid "Please reload the page and try again."
msgstr "يرجى إعادة تحميل الصفحة والمحاولة مرة أخرى."

#: mizzey-site/src/Reviews/ReviewEligibility.php
msgid "You have already reviewed this product. Thank you."
msgstr "لقد قيّمت هذا المنتج من قبل. شكرًا لك."

#: mizzey-site/src/Reviews/ReviewEligibility.php
msgid "Only customers whose order for this product has been delivered can review it."
msgstr "يمكن تقييم هذا المنتج فقط من العملاء الذين وصلهم طلبهم منه."

#: mizzey-site/src/Reviews/ReviewEligibility.php
msgid "Review not accepted"
msgstr "لم يُقبل التقييم"

#: mizzey-site/src/Reviews/ReviewInvitationEmail.php
msgid "How was your order #{order_number}?"
msgstr "ما رأيك في طلبك رقم {order_number}؟"

#: mizzey-site/src/Reviews/ReviewInvitationEmail.php
msgid "Tell us what you think"
msgstr "شاركنا رأيك"

#: mizzey-site/src/Reviews/ReviewInvitationEmail.php
#. translators: %s: customer first name.
#, php-format
msgid "Hello %s,"
msgstr "مرحبًا %s،"

#: mizzey-site/src/Reviews/ReviewInvitationEmail.php
msgid "Your order has been delivered. We would love to hear what you think of it:"
msgstr "تم توصيل طلبك. يسعدنا أن نعرف رأيك فيه:"

#: mizzey-site/src/Reviews/ReviewEligibility.php
msgid "Please choose a rating from 1 to 5 stars."
msgstr "يرجى اختيار تقييم من نجمة إلى 5 نجوم."

#: mizzey-site/src/Reviews/ReviewEligibility.php
msgid "Only staff who moderate reviews can publish one."
msgstr "لا ينشر التقييمات إلا الموظفون المخوّلون بمراجعتها."

#: mizzey-site/src/Accounts/GoogleSignIn.php
