msgstr "المتابعة باستخدام Google"

#: mizzey-site/src/Accounts/GoogleSignIn.php
msgid "Staff accounts sign in with their password."
msgstr "تسجيل دخول حسابات الموظفين يكون بكلمة المرور."

#: mizzey-site/src/Accounts/GoogleSignIn.php
