# Spec 066, slice 5, review round: the sign-up's failure words and the leave page's failure (HOME-09).
#: mizzey-site/src/Signups/SignupService.php
msgid "This form could not be checked. Reload the page and try again."
msgstr "تعذر التحقق من هذا النموذج. أعد تحميل الصفحة وحاول مرة أخرى."

#: mizzey-site/src/Signups/SignupService.php
msgid "We could not sign you up just now. Please try again in a few minutes."
msgstr "تعذر اشتراكك الآن. يرجى المحاولة مرة أخرى بعد بضع دقائق."

#: mizzey-site/src/Signups/SignupService.php
msgid "We could not reach Mizzey. Check your connection and try again."
msgstr "تعذر الوصول إلى ميزي. تحقق من اتصالك وحاول مرة أخرى."

#: mizzey-site/src/Signups/SignupService.php
msgid "Sign-up is paused for a moment while we work on the site. Please try again shortly."
msgstr "الاشتراك متوقف لحظات بينما نعمل على الموقع. يرجى المحاولة بعد قليل."

#: mizzey-site/src/Signups/LeavePage.php
msgid "We could not do that just now"
msgstr "تعذر تنفيذ ذلك الآن"

#: mizzey-site/src/Signups/LeavePage.php
msgid "Please open the link again in a few minutes."
msgstr "يرجى فتح الرابط مرة أخرى بعد بضع دقائق."

#: mizzey-site/src/Signups/SignupService.php
msgid "Your address is kept. Press Sign up again to finish."
msgstr "عنوانك محفوظ. اضغط اشترك مرة أخرى للإتمام."

