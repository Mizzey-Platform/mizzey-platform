# The staging and demonstration web server. Generated by staging.py into ../app-staging/run. Do not edit there.
#
# It is its own Apache process with its own configuration, on its own port. It shares only the installed
# binaries with the development server: no virtual host, no document root, no log and no session of the
# development site is reachable from it.

Define STAGING_ROOT "{{STAGING_ROOT}}"
ServerRoot "{{APACHE}}"
PidFile "${STAGING_ROOT}/run/httpd.pid"
Listen 127.0.0.1:{{PORT}}
ServerName 127.0.0.1:{{PORT}}
ServerAdmin staging@example.invalid
ServerTokens Prod
ServerSignature Off
AcceptFilter http none
EnableSendfile Off
EnableMMAP Off
Timeout 120
KeepAlive On

LoadModule authn_core_module modules/mod_authn_core.so
LoadModule authn_file_module modules/mod_authn_file.so
LoadModule authz_core_module modules/mod_authz_core.so
LoadModule authz_host_module modules/mod_authz_host.so
LoadModule authz_user_module modules/mod_authz_user.so
LoadModule auth_basic_module modules/mod_auth_basic.so
LoadModule dir_module modules/mod_dir.so
LoadModule env_module modules/mod_env.so
LoadModule headers_module modules/mod_headers.so
LoadModule log_config_module modules/mod_log_config.so
LoadModule mime_module modules/mod_mime.so
LoadModule setenvif_module modules/mod_setenvif.so

PHPIniDir "{{APACHE}}/bin"
LoadModule php_module "{{PHP}}/php8apache2_4.dll"

# Enough threads for the concurrency harness to produce real simultaneity (workstream item B6).
<IfModule mpm_winnt_module>
    ThreadsPerChild 96
    MaxConnectionsPerChild 0
</IfModule>

TypesConfig conf/mime.types
AddType application/x-httpd-php .php
DirectoryIndex index.php index.html

ErrorLog "${STAGING_ROOT}/logs/error.log"
LogLevel warn
LogFormat "%h %{CF-Connecting-IP}i %t \"%r\" %>s %b %D \"%{User-Agent}i\"" staging
CustomLog "${STAGING_ROOT}/logs/access.log" staging

DocumentRoot "${STAGING_ROOT}/wp"

# A request that arrived through the Cloudflare Tunnel carries headers the edge adds and a visitor cannot remove.
# cloudflared connects from this machine, so "local" alone would wave the whole internet through.
SetEnvIf CF-Connecting-IP ".+" VIA_TUNNEL
SetEnvIf Cf-Ray ".+" VIA_TUNNEL
SetEnvIf X-Forwarded-For ".+" VIA_TUNNEL

# Staging is never indexed, whatever WordPress is told.
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set X-Mizzey-Environment "staging"

<Directory />
    AllowOverride None
    Require all denied
</Directory>

<Directory "${STAGING_ROOT}/wp">
    Options FollowSymLinks
    AllowOverride None

    # Direct requests from this machine pass. Anything that came through the tunnel must sign in first.
    AuthType Basic
    AuthName "Mizzey staging. Demonstration copy, invented data."
    AuthBasicProvider file
    AuthUserFile "${STAGING_ROOT}/run/htpasswd"
    <RequireAny>
        <RequireAll>
            Require local
            Require not env VIA_TUNNEL
        </RequireAll>
        Require valid-user
    </RequireAny>

    # WordPress pretty permalinks, without an .htaccess file for anything to rewrite.
    FallbackResource /index.php

    # No mail leaves this machine. WordPress mail is captured before it is sent (the staging plugin); this
    # makes a direct mail() call fail closed as well.
    php_admin_value SMTP 127.0.0.1
    php_admin_value smtp_port 9
    php_admin_value sendmail_from staging@example.invalid
    php_admin_value error_log "${STAGING_ROOT}/logs/php-error.log"
</Directory>

<Directory "${STAGING_ROOT}/wp/wp-content/uploads">
    php_admin_flag engine off
</Directory>

<FilesMatch "^(wp-config\.php|xmlrpc\.php|readme\.html|license\.txt)$">
    Require all denied
</FilesMatch>
