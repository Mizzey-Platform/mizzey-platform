# Cloudflare Tunnel for the staging and demonstration copy. Generated by `staging.py tunnel-config`.
# Fill in the tunnel id after `cloudflared tunnel create mizzey-staging` (docs/staging-environment.md).
tunnel: REPLACE-WITH-TUNNEL-ID
credentials-file: {{STAGING_ROOT}}/run/cloudflared-credentials.json

ingress:
  - hostname: {{HOSTNAME}}
    service: http://127.0.0.1:{{PORT}}
    originRequest:
      httpHostHeader: {{HOSTNAME}}
  - service: http_status:404
