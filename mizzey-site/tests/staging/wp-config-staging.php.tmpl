<?php
/**
 * Staging and demonstration configuration. Generated by mizzey-site/tests/staging/staging.py into
 * ../app-staging/wp, which is outside the repository. It holds generated secrets: never commit the result.
 *
 * Nothing here is shared with the development runtime: its own database and account, its own table prefix,
 * its own keys (so no session of one is valid on the other), its own uploads.
 */

define( 'DB_NAME', '{{DB_NAME}}' );
define( 'DB_USER', '{{DB_USER}}' );
define( 'DB_PASSWORD', '{{DB_PASSWORD}}' );
define( 'DB_HOST', '127.0.0.1' );
define( 'DB_CHARSET', 'utf8mb4' );
define( 'DB_COLLATE', '' );

define( 'AUTH_KEY', '{{SALT_1}}' );
define( 'SECURE_AUTH_KEY', '{{SALT_2}}' );
define( 'LOGGED_IN_KEY', '{{SALT_3}}' );
define( 'NONCE_KEY', '{{SALT_4}}' );
define( 'AUTH_SALT', '{{SALT_5}}' );
define( 'SECURE_AUTH_SALT', '{{SALT_6}}' );
define( 'LOGGED_IN_SALT', '{{SALT_7}}' );
define( 'NONCE_SALT', '{{SALT_8}}' );
define( 'WP_CACHE_KEY_SALT', '{{SALT_9}}' );

$table_prefix = '{{TABLE_PREFIX}}';

define( 'WP_ENVIRONMENT_TYPE', 'staging' );
define( 'MIZZEY_STAGING', true );
define( 'MIZZEY_STAGING_ROOT', '{{STAGING_ROOT}}' );

// The address. Locally it is the loopback address. Through the Cloudflare Tunnel it is whichever public host
// name `staging.py tunnel-config` has allowed, and no other: an unlisted Host header gets the local address.
$mizzey_local   = '127.0.0.1:{{PORT}}';
$mizzey_allowed = array( $mizzey_local, 'localhost:{{PORT}}' );
$mizzey_list    = MIZZEY_STAGING_ROOT . '/allowed-hosts.txt';
if ( is_readable( $mizzey_list ) ) {
	foreach ( file( $mizzey_list, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES ) as $mizzey_line ) {
		if ( '#' !== $mizzey_line[0] ) {
			$mizzey_allowed[] = strtolower( trim( $mizzey_line ) );
		}
	}
}
$mizzey_host   = strtolower( $_SERVER['HTTP_HOST'] ?? $mizzey_local );
$mizzey_host   = in_array( $mizzey_host, $mizzey_allowed, true ) ? $mizzey_host : $mizzey_local;
$mizzey_public = ! in_array( $mizzey_host, array( $mizzey_local, 'localhost:{{PORT}}' ), true );
// Cloudflare ends the TLS connection and forwards plain HTTP, so a public host name is always served as HTTPS.
if ( $mizzey_public ) {
	$_SERVER['HTTPS'] = 'on';
}
define( 'WP_HOME', ( $mizzey_public ? 'https://' : 'http://' ) . $mizzey_host );
define( 'WP_SITEURL', WP_HOME );
define( 'FORCE_SSL_ADMIN', $mizzey_public );

// Staging runs the commit it was built from and nothing else: no edits, no installs, no self-updates.
define( 'DISALLOW_FILE_EDIT', true );
define( 'DISALLOW_FILE_MODS', true );
define( 'AUTOMATIC_UPDATER_DISABLED', true );
define( 'WP_AUTO_UPDATE_CORE', false );

// No request leaves this machine for a real provider. A provider sandbox is allowed by name when one is wired.
define( 'WP_HTTP_BLOCK_EXTERNAL', true );
define( 'WP_ACCESSIBLE_HOSTS', '127.0.0.1,localhost' );

define( 'WP_MEMORY_LIMIT', '512M' );
define( 'WP_MAX_MEMORY_LIMIT', '512M' );
define( 'WP_DEBUG', true );
define( 'WP_DEBUG_LOG', MIZZEY_STAGING_ROOT . '/logs/wp-debug.log' );
define( 'WP_DEBUG_DISPLAY', false );

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}
require_once ABSPATH . 'wp-settings.php';
